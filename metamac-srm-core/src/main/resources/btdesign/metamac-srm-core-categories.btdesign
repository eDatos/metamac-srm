import "classpath:/btdesign/statistic-sdmx-core-common.btdesign"
import "classpath:/btdesign/metamac-core-common-enum.btdesign"
import "classpath:/btdesign/statistic-sdmx-core-base.btdesign"
import "classpath:/btdesign/statistic-sdmx-core-categories.btdesign"
import "classpath:/btdesign/metamac-srm-core-enum.btdesign"
import "classpath:/btdesign/statistic-sdmx-v2_1-domain-enums.btdesign"
import "classpath:/btdesign/metamac-srm-core-base.btdesign"
import "classpath:/btdesign/metamac-srm-core-master-tables.btdesign"

Application CategoriesMetamac {
	basePackage=unused

	Module domain_categories_metamac {
		basePackage=org.siemac.metamac.srm.core.category

		// ----------------------------------------------------------------
		// 							SERVICES
		// ----------------------------------------------------------------  
		"Provides access to Scheme Categories Artefacts"
		Service CategoriesMetamacService {

			> @CategorySchemeVersionMetamacRepository
			> @CategoryMetamacRepository
			> @CategoryElementRepository
			> @CategorySchemeOrderVisualisationRepository
			
			"Creates category scheme"
			@CategorySchemeVersionMetamac createCategoryScheme(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException;
			"Pre-Create category scheme"
			@CategorySchemeVersionMetamac preCreateCategoryScheme(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException
			"Updates category scheme"
			@CategorySchemeVersionMetamac updateCategoryScheme(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException;
			"Retrieves category scheme by urn"
			@CategorySchemeVersionMetamac retrieveCategorySchemeByUrn(String urn) throws MetamacException;
			"Retrieves all category schemes versions"
			List<@CategorySchemeVersionMetamac> retrieveCategorySchemeVersions(String urn) throws MetamacException;
			"Finds category schemes by criteria"
    		PagedResult<@CategorySchemeVersionMetamac> findCategorySchemesByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter)  throws MetamacException;
    		"Finds category schemes with categories can be category in categorisation"
    		PagedResult<@CategorySchemeVersionMetamac> findCategorySchemesWithCategoriesCanBeCategorisationCategoryByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter) throws MetamacException;
    		"Sends category scheme to production validation"
    		@CategorySchemeVersionMetamac sendCategorySchemeToProductionValidation(String urn) throws MetamacException;
    		"Sends category scheme to diffusion validation"
    		@CategorySchemeVersionMetamac sendCategorySchemeToDiffusionValidation(String urn) throws MetamacException;
	    	"Rejects production validation of category scheme"    		
	    	@CategorySchemeVersionMetamac rejectCategorySchemeProductionValidation(String urn) throws MetamacException;
	    	"Rejects diffusion validation of category scheme"
	    	@CategorySchemeVersionMetamac rejectCategorySchemeDiffusionValidation(String urn) throws MetamacException;
	    	"Publish internally a category scheme"
	    	ResourceVersionPublicationResult<@CategorySchemeVersionMetamac> publishInternallyCategoryScheme(String urn, Boolean forceLatestFinal) throws MetamacException;
	    	"Publish externally a category scheme"
	    	ResourceVersionPublicationResult<@CategorySchemeVersionMetamac> publishExternallyCategoryScheme(String urn) throws MetamacException;
	    	"Resend a category scheme"
            org.siemac.metamac.srm.core.serviceimpl.result.SendStreamMessageResult resendCategoryScheme(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException;
			"Deletes category scheme version. This must be last version and no published"
    		deleteCategoryScheme(String urn) throws MetamacException;
    		"Copies a category scheme version, creating a new category scheme, newCode is optional, skip to reuse before"
    		TaskInfo copyCategoryScheme(String urnToCopy, String newCode) throws MetamacException;
    		"Creates a new version of a category scheme, copying metadata from version with provided urn"
    		TaskInfo versioningCategoryScheme(String urnToCopy, @VersionTypeEnum versionType) throws MetamacException;
    		"Creates a temporal version of a category scheme, copying metadata from version with provided urn"
    		TaskInfo createTemporalVersionCategoryScheme(String urnToCopy) throws MetamacException;
    		"Creates a new version of a category scheme from temporal version with provided urn"
    		TaskInfo createVersionFromTemporalCategoryScheme(String urnToCopy, @VersionTypeEnum versionTypeEnum) throws MetamacException;
    		"Merge temporal version into published version"
    		@CategorySchemeVersionMetamac mergeTemporalVersion(@CategorySchemeVersionMetamac categorySchemeTemporalVersion) throws MetamacException;
    		"Starts the category scheme validity"
    		@CategorySchemeVersionMetamac startCategorySchemeValidity(String urn) throws MetamacException;
    		"Ends the category scheme validity"
    		@CategorySchemeVersionMetamac endCategorySchemeValidity(String urn) throws MetamacException;
    		"Retrieves categories scheme by category urn"
    		@CategorySchemeVersionMetamac retrieveCategorySchemeByCategoryUrn(String categoryUrn) throws MetamacException;
			"Checks translations for category scheme"
			checkCategorySchemeVersionTranslations(Long itemSchemeVersionId, String locale, Map<String, MetamacExceptionItem> exceptionsByResourceUrn) throws MetamacException;
			"Checks related resources are externally published"
    		checkCategorySchemeWithRelatedResourcesExternallyPublished(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException;
    		
			"Creates category"
			@CategoryMetamac createCategory(String categorySchemeUrn, @CategoryMetamac category) throws MetamacException;
			"Pre Create"
			@CategoryMetamac preCreateCategory(String categorySchemeUrn, @CategoryMetamac category) throws MetamacException;
			"Updates category"
			@CategoryMetamac updateCategory(@CategoryMetamac category) throws MetamacException;
    		"Retrieves category by urn"
    		@CategoryMetamac retrieveCategoryByUrn(String urn) throws MetamacException;
    		"Finds categories by criteria"
    		PagedResult<@CategoryMetamac> findCategoriesByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter)  throws MetamacException;
    		"Finds categories can be category in categorisation"
    		PagedResult<@CategoryMetamac> findCategoriesCanBeCategorisationCategoryByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter) throws MetamacException;
			"Deletes category"
    		deleteCategory(String urn) throws MetamacException;
    		"Updates parent of category"
    		updateCategoryParent(String categoryUrn, String newCategoryParentUrn) throws MetamacException;
    		"Retrieves categories by category scheme in locale requested"
    		List<CategoryMetamacVisualisationResult> retrieveCategoriesByCategorySchemeUrn(String categorySchemeUrn, String locale, String categorySchemeOrderVisualisationUrn) throws MetamacException;
    		"Retrieves categories by category scheme unordered"
    		List<ItemResult> retrieveCategoriesByCategorySchemeUrnUnordered(String categorySchemeUrn, ItemResultSelection itemResultSelection) throws MetamacException;
    		"Retrieves categories by category scheme ordered in depth by order visualisation"
    		List<ItemResult> retrieveCategoriesByCategorySchemeUrnOrderedInDepth(String categorySchemeUrn, ItemMetamacResultSelection itemMetamacResultSelection, String orderVisualisationCode) throws MetamacException;
    		"Imports categories in TSV format"
    		TaskImportationInfo importCategoriesTsv(String categorySchemeUrn, java.io.File file, String fileName, boolean updateAlreadyExisting, Boolean canBeBackground) throws MetamacException;
			"Exports categories in TSV format"
    		String exportCategoriesTsv(String categorySchemetUrn) throws MetamacException;

    		// VISUALISATIONS

    		"Creates order visualisation"
    		@CategorySchemeOrderVisualisation createCategorySchemeOrderVisualisation(String categorySchemeUrn, @CategorySchemeOrderVisualisation categorySchemeOrderVisualisation) throws MetamacException;
    		"Creates alphabetical order visualisation"
    		@CategorySchemeVersionMetamac createCategorySchemeOrderVisualisationAlphabetical(@CategorySchemeVersionMetamac categorySchemeVersion) throws MetamacException;
    		"Updates order visualisation"
    		@CategorySchemeOrderVisualisation updateCategorySchemeOrderVisualisation(@CategorySchemeOrderVisualisation categorySchemeOrderVisualisation) throws MetamacException;
    		"Retrieves order visualisation by urn"
    		@CategorySchemeOrderVisualisation retrieveCategorySchemeOrderVisualisationByUrn(String urn) throws MetamacException;
    		"Retrieves order visualisation by code"
    		@CategorySchemeOrderVisualisation retrieveCategorySchemeOrderVisualisationByCode(String categorySchemeUrn, String code) throws MetamacException;
    		"Retrieve order visualisations by category scheme"
    		List<@CategorySchemeOrderVisualisation> retrieveCategorySchemeOrderVisualisationsByCategoryScheme(String categorySchemeUrn) throws MetamacException;
    		"Deletes order visualisation"
    		deleteCategorySchemeOrderVisualisation(String urn) throws MetamacException;
    		@CategorySchemeVersionMetamac versioningCategorySchemeOrderVisualisations(@CategorySchemeVersionMetamac source, @CategorySchemeVersionMetamac target) throws MetamacException;
    		"Recalculates order when new categories are added in category scheme"
    		recalculateCategoriesVisualisations(List<@Category> items, List<@CategorySchemeOrderVisualisation> orderVisualisations, boolean executeSave);

    		"Updates position of category in order visualisation"
    		updateCategoryInOrderVisualisation(String categoryUrn, String categorySchemeOrderVisualisationUrn, Integer newCategoryIndex) throws MetamacException;

    		"Imports category scheme orders in tsv format"
    		TaskImportationInfo importCategorySchemeOrdersTsv(String categorySchemeUrn, java.io.File file, String fileName, Boolean canBeBackground) throws MetamacException;
    		String exportCategoryOrdersTsv(String categorySchemeUrn) throws MetamacException;

    		// Categorisations
    		"Creates categorisation"
    		@Categorisation createCategorisation(String categoryUrn, String artefactCategorisedUrn, String maintainerUrn) throws MetamacException;
    		"Pre Create"
    		preCreateCategorisation(String categoryUrn, String artefactCategorisedUrn, String maintainerUrn) throws MetamacException;
    		"Post Create"
    		@Categorisation postCreateCategorisation(String artefactCategorisedUrn, @Categorisation categorisation) throws MetamacException;
    		"Convert temporal categorisations in real versions"
    		createVersionFromTemporalCategorisations(@MaintainableArtefact maintainableArtefact) throws MetamacException;
    		"Retrieves categorisation by urn"
    		@Categorisation retrieveCategorisationByUrn(String urn) throws MetamacException;
    		"Deletes categorisation"
    		deleteCategorisation(String urn) throws MetamacException;
    		"Marks a categorisation as final"
    		@Categorisation markCategorisationAsFinal(String urn) throws MetamacException;
    		"Marks a categorisation as public"
    		@Categorisation markCategorisationAsPublic(String urn) throws MetamacException;
    		"Starts the validity of a categorisation. ValidFrom date is optional"
    		@Categorisation startCategorisationValidity(String urn, DateTimeTZ validFrom) throws MetamacException;
    		"Ends the validity of a categorisation. ValidTo date is optional"
    		@Categorisation endCategorisationValidity(String urn, DateTimeTZ validTo) throws MetamacException;
    		"Retrieves all categorisations by categorised artefact"
    		List<@Categorisation> retrieveCategorisationsByArtefact(String urn) throws MetamacException;
			"Finds categorisations by criteria"
    		PagedResult<@Categorisation> findCategorisationsByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter)  throws MetamacException;
			"Checks categorisations have related resources externally published"
    		checkCategorisationsWithRelatedResourcesExternallyPublished(String artefactCategorisedUrn, Map<String, MetamacExceptionItem> exceptionItemsByUrn) throws MetamacException;
    		
    		//category elements
    		"Deletes category element"
    		deleteCategoryElement(String urn) throws MetamacException;
    		@CategoryElement createCategoryElement(@CategoryElement categoryElement) throws MetamacException;
			"Updates category element"
			@CategoryElement updateCategoryElement(@CategoryElement categoryElement) throws MetamacException;
    		"Retrieves variable element by urn"
    		@CategoryElement retrieveCategoryElementByUrn(String urn) throws MetamacException;
    		"Finds category elements by criteria"
    		PagedResult<@CategoryElement> findCategoryElementsByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter)  throws MetamacException;
    		"Exports category elements in tsv format"
    		String exportCategoryElementsTsv(List<String> categoryElementUrns) throws MetamacException;
    		"Imports category elements in tsv format"
    		TaskImportationInfo importCategoryElementsTsv(java.io.File file, String fileName, boolean updateAlreadyExisting, Boolean canBeBackground) throws MetamacException;
    		"Change category element of category"
			@CategoryMetamac updateCategoryElementOfCategory(String categoryUrn, String categoryElementUrn) throws MetamacException;
			"Change category elements to codes"
			updateCodesCategoryElements(String categorySchemeUrn, Map<Long,Long> categoryElementsIdByCodeId) throws MetamacException;
			"Proposes a normalisation of category elements to categories. If boolean is true, only normalise categories without category element. To categories with category element returns actual category element"
	   		List<CodeCategoryElementNormalisationResult> normaliseCategoryElementsToCategories(String categorySchemeUrn, String locale, boolean proposeOverridingOnlyWithoutCategoryElement) throws MetamacException;
	   		"retrieve category element logo file"
    		String retrieveCategoryElementLogo(String categoryElementUrn) throws MetamacException;
    		"delete category element logo file"
    		deleteCategoryElementLogo(String categoryElementUrn) throws MetamacException;
	   		
			// resend kafka message for the last number of version of published category.
    		List<MetamacExceptionItem> resendKafkaMessageExternallyCategorySchemes() throws MetamacException;
    		"Load category element logo"
    		TaskImportationInfo importCategoryElementLogo(String categoryElementUrn, String fileName, InputStream imageStream, Boolean canBeBackground) throws MetamacException;
   		}

		// ----------------------------------------------------------------
		// 							ENTITIES
		// ----------------------------------------------------------------  
		Entity CategorySchemeVersionMetamac extends @CategorySchemeVersion {
			databaseTable="TB_M_CAT_SCHEMES_VERSIONS"
			hint="idSequence=M_CAT_SCHEMES_VERSIONS"

			"Life cycle information"
			- @SrmLifeCycleMetadata lifeCycleMetadata databaseColumn="";
			"Stream message status"
            - @StreamMessageStatusEnum streamMessageStatus;

			"Order visualisations"
			- Bag<@CategorySchemeOrderVisualisation> orderVisualisations cascade="all-delete-orphan" fetch="lazy" inverse orderby="id asc" <-> categorySchemeVersion;
			"Default order visualisation"
			- @CategorySchemeOrderVisualisation defaultOrderVisualisation nullable cascade="persist,merge,refresh" fetch="lazy" databaseColumn="DEFAULT_ORDER_VISUAL_FK";

			Repository CategorySchemeVersionMetamacRepository {
				save;
				findByQuery(String query, Map<String, Object> parameters, int maxResult);
				findByCondition(PagingParameter pagingParameter);
				@CategorySchemeVersionMetamac findByUrn(String urn);
				@CategorySchemeVersionMetamac retrieveCategorySchemeVersionByProcStatus(String urn, ArrayProcStatusEnum procStatus) throws MetamacException;
				@CategorySchemeVersionMetamac findByCategory(String urn);
				checkCategorySchemeVersionTranslations(Long itemSchemeVersionId, String locale, Map<String, MetamacExceptionItem> exceptionItemsByUrn) throws MetamacException;
				List<@CategorySchemeVersionMetamac> retrieveCategorySchemesPublishedExternally() throws MetamacException;
			}			
		}
		
		Entity CategoryMetamac extends @Category {
			databaseTable="TB_M_CATEGORIES"
			hint="idSequence=M_CATEGORIES"

			- @CategoryElement categoryElement nullable cascade="none" fetch="lazy" databaseColumn="CATEGORY_ELEMENT_FK"  <-> codes;
			"Metadata ENI SCHEMA"
			- Set<@EniSchemaCatalog> eniSchemas cascade="none" fetch="lazy" databaseJoinTable="TB_CAT_ENI_SCHEMA";

			Integer order1 nullable;
			Integer order2 nullable;
			Integer order3 nullable;
			Integer order4 nullable;
			Integer order5 nullable;
			Integer order6 nullable;
			Integer order7 nullable;
			Integer order8 nullable;
			Integer order9 nullable;
			Integer order10 nullable;
			Integer order11 nullable;
			Integer order12 nullable;
			Integer order13 nullable;
			Integer order14 nullable;
			Integer order15 nullable;
			Integer order16 nullable;
			Integer order17 nullable;
			Integer order18 nullable;
			Integer order19 nullable;
			Integer order20 nullable;

			Repository CategoryMetamacRepository {
				save;
				findByQuery;
				findByQuery(String query, Map<String, Object> parameters, int maxResult);
				@CategoryMetamac findByUrn(String urn);
				findByCondition(PagingParameter pagingParameter);
				List<ItemResult> findCategoriesByCategorySchemeUnordered(Long itemSchemeVersionId, ItemMetamacResultSelection resultSelection) throws MetamacException;
				List<ItemResult> findCategoriesByCategorySchemeOrderedInDepth(Long itemSchemeVersionId, Integer orderColumnIndex, ItemMetamacResultSelection resultSelection) throws MetamacException;
				List<CategoryMetamacVisualisationResult> findCategoriesByCategorySchemeUnorderedToVisualisation(Long itemSchemeVersionId, String locale, Integer orderColumnIndex) throws MetamacException;
				updateCodesCategoryElements(Map<Long,Long> categoryElementsByCodes, Long categorySchemeId) throws MetamacException;
				checkCategoryTranslations(Long itemSchemeVersionId, String locale, Map<String, MetamacExceptionItem> exceptionItemsByUrn) throws MetamacException;

				Integer getMaximumOrderInLevel(@CategorySchemeVersionMetamac categorySchemeVersion, @Category parent, Integer orderColumnIndex);
				reorderCategoriesDeletingOneCode(@CategorySchemeVersionMetamac categorySchemeVersion, @Category parent, @CategoryMetamac category, Integer orderColumnIndex, Integer orderCategoryToDelete);
				reorderCategoriesAddingOneCodeInMiddle(@CategorySchemeVersionMetamac categorySchemeVersion, @CategoryMetamac category, Integer orderColumnIndex, Integer orderCategoryToAdd);
				Integer getCategoryAlphabeticPositionInLevel(@CategorySchemeVersionMetamac categorySchemeVersion, @Category parent, @Category category);
				clearCategoriesOrderColumn(@CategorySchemeVersionMetamac categorySchemeVersion, Integer orderColumnIndex);
				copyCategoriesOrderColumn(@CategorySchemeVersionMetamac categorySchemeVersion, Integer columnIndexSource, Integer columnIndexTarget);
			}
		}
				
		Entity CategoryElement extends @ResourceElement {
			databaseTable="TB_CAT_RESOURCE_ELEMENTS"
			hint="idSequence=M_CAT_RESOURCE_ELEMENTS"

			- Bag<@CategoryMetamac> codes cascade="none" fetch="lazy" <-> categoryElement;
			"Is visible"
			Boolean isVisible;
			  "logo"
			- @ResourceMetadataFile logo nullable cascade="all" fetch="lazy" databaseColumn="LOGO_FK";
			Repository CategoryElementRepository {
				save;
				delete;
				findAll;
				findByQuery;
				@CategoryElement findByUrn(String urn);
				@CategoryElement findByCode(String code);
				List<@CategoryElement> findByUrnIn(List<String> urns);
				List<@CategoryElement> findByCodeIn(List<String> codes);
				findByCondition(PagingParameter pagingParameter);

			}
		}

		Entity CategorySchemeOrderVisualisation {
			databaseTable="TB_M_CAT_SCHEME_ORDER_VIS"
			hint="idSequence=M_CAT_SCHEME_ORDER_VIS"

			"Nameable artefact"
			- @NameableArtefact nameableArtefact not nullable cascade="all" fetch="lazy" databaseColumn="NAMEABLE_ARTEFACT_FK";
			"Last update for optimistic locking"
			DateTimeTZ updateDate nullable;
			"Column with order in table of Categories"
			Integer columnIndex not nullable;
			"Relation to category scheme"
			- @CategorySchemeVersionMetamac categorySchemeVersion not nullable cascade="none" fetch="lazy" databaseColumn="CATEGORY_SCHEME_FK" <-> orderVisualisations;

			Repository CategorySchemeOrderVisualisationRepository {
				save;
				delete;
				findByQuery(String query, Map<String, Object> parameters, int maxResult);
				@CategorySchemeOrderVisualisation findByUrn(String orderVisualisationUrn);
				@CategorySchemeOrderVisualisation findByCode(Long categorySchemeId, String orderVisualisationCode);
				findByCondition(PagingParameter pagingParameter);
				updateUrnAllCategorySchemeOrderVisualisationsByCategorySchemeEfficiently(@CategorySchemeVersionMetamac categorySchemeVersionMetamac, String oldUrnExample);
				checkCategorySchemeOrderVisualisationTranslations(Long itemSchemeVersionId, String locale, Map<String, MetamacExceptionItem> exceptionItemsByUrn) throws MetamacException;
			}
		}
	}
}