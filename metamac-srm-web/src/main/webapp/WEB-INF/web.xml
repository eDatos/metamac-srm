<?xml version="1.0" encoding="UTF-8"?>
<web-app id="metamac-srm-external-web" version="2.5"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"  
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">


    <!-- ********************* SPRING INTEGRATION ******************** -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>/WEB-INF/config/spring/applicationContext.xml </param-value>
    </context-param>

    <!-- Creates the Spring Container shared by all Servlets and Filters -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- Application startup listener to validate the configuration properties -->
    <listener>
        <listener-class>org.siemac.metamac.srm.web.server.listener.SrmApplicationStartupListener</listener-class>
    </listener>

    <!-- Enable Spring Request Context Holder -->
    <listener>
        <listener-class>org.springframework.web.context.request.RequestContextListener</listener-class>
    </listener>

    <!-- SSO -->
    <listener>
        <listener-class>org.siemac.metamac.web.common.server.session.SingleSignOutHttpSessionListener</listener-class>
    </listener>
    <!--  WHY THIS FILTER ORDER?
	  
	  (1) CORSFilter
	      • MUST execute first so that the Access-Control* headers are added while
	        the original request URL is still intact.  
	      • Guarantees that the headers survive any subsequent internal
	        forward/redirect performed by downstream filters or servlets.
	
	  (2) UrlRewriteFilter
	      • Performs server-side rewrites/forwards (e.g., /api/v1/* → /legacy/*).  
	      • Runs after CORS so that the rewritten request already carries the
	        correct cross-origin headers—otherwise they could be lost or duplicated
	        when the request re-enters the filter chain.
	
	  (3) DeprecationFilter
	      • Runs last to log or flag the *final* endpoint that was actually served,
	        not the one originally requested nor any intermediate rewrite.  
	      • Ensures accurate analytics, deprecation warnings, and metrics.
	
	  All three mappings include:
	      <dispatcher>REQUEST</dispatcher>
	      <dispatcher>FORWARD</dispatcher>
	  so they apply both to the external client request (REQUEST) and to any
	  internal forwards initiated by UrlRewriteFilter (FORWARD). This keeps header
	  handling and logging consistent across the entire request lifecycle.
	-->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>org.siemac.metamac.core.common.filter.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/apis/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <!-- URL rewriting -->
    <filter>
            <filter-name>UrlRewriteFilter</filter-name>
            <filter-class>org.tuckey.web.filters.urlrewrite.UrlRewriteFilter</filter-class>
    </filter>
    <filter-mapping>
            <filter-name>UrlRewriteFilter</filter-name>
            <url-pattern>/apis/*</url-pattern>
            <dispatcher>REQUEST</dispatcher>
            <dispatcher>FORWARD</dispatcher>
    </filter-mapping> 

    <!-- Spring dispatcher for GWT-RPC services.
        See: http://code.google.com/p/gwt-platform/source/browse/gwtp-samples/gwtp-sample-basic-spring/src/main/webapp/WEB-INF/web.xml?r=7efb6ee3ef7b9458693830e713d679f1c78e98dd -->
    <servlet>
        <servlet-name>dispatch</servlet-name>
        <servlet-class>org.springframework.web.context.support.HttpRequestHandlerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatch</servlet-name>
        <url-pattern>/dispatch/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>upload</servlet-name>
        <servlet-class>org.siemac.metamac.srm.web.server.servlet.ResourceImportationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>upload</servlet-name>
        <url-pattern>/files/upload/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>uploadPreview</servlet-name>
        <servlet-class>org.siemac.metamac.srm.web.server.servlet.ResourceImportationPreviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>uploadPreview</servlet-name>
        <url-pattern>/files/upload-preview/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>download</servlet-name>
        <servlet-class>org.siemac.metamac.srm.web.server.servlet.FileDownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>download</servlet-name>
        <url-pattern>/files/download/*</url-pattern>
    </servlet-mapping>

    <!-- Remote logging -->
    <servlet>
        <servlet-name>remoteLogging</servlet-name>
        <servlet-class>com.google.gwt.logging.server.RemoteLoggingServiceImpl</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>remoteLogging</servlet-name>
        <url-pattern>/MetamacSrmWeb/remote_logging</url-pattern>
    </servlet-mapping>

    <!-- Rest -->
    <servlet>
        <servlet-name>CXFServlet</servlet-name>
        <servlet-class>org.apache.cxf.transport.servlet.CXFServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CXFServlet</servlet-name>
        <url-pattern>/apis/*</url-pattern>
    </servlet-mapping>

    <!-- Logout filter -->
    <filter>
        <filter-name>logoutFilter</filter-name>
        <filter-class>org.siemac.metamac.web.common.server.session.SingleSignOutFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>logoutFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ******************* Default page to serve ******************** -->
    <welcome-file-list>
        <welcome-file>MetamacSrmWeb.jsp</welcome-file>
    </welcome-file-list>

 <!-- Establish custom accept header for certains urls. Two parameters.
   - first parameter: Start with "url-path" + any description. This parameters are urls separated by commas in the case that more than one pattern exists.
   - second parameter: Start with "default-type-" + the name of the parameters with the urls.
  -->
	<filter>
        <filter-name>HttpWrapperFilter</filter-name>
        <filter-class>org.siemac.metamac.rest.request.filter.HttpWrapperFilter</filter-class>
        <init-param>
            <param-name>url-path-images</param-name>
            <param-value>*/logo</param-value> <!-- urls separated by commas -->
        </init-param>
        <init-param>
            <param-name>default-type-url-path-images</param-name>
            <param-value>image/*</param-value> 
        </init-param>
    </filter>
    
    <filter-mapping>
        <filter-name>HttpWrapperFilter</filter-name>
        <url-pattern>/apis/*</url-pattern>
    </filter-mapping>

</web-app>
